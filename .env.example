VITE_API_URL="https://api.tourshop-express.com"
VITE_APP_VERSION="1.0.0"

# WebSocket temps reel (Laravel Reverb), memes valeurs que client-app.
# Sans cle, l'app fonctionne en rafraichissement (retour au premier plan).
VITE_REVERB_APP_KEY=tourshop-key
VITE_REVERB_HOST=ws.tourshop-express.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
